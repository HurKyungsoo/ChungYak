# 배포용 환경변수 템플릿. `cp .env.example .env` 후 값을 채운다.
# .env 는 절대 커밋하지 말 것 (.gitignore 처리됨).

# ── 도메인 (Caddy HTTPS) ──
DOMAIN=chungyak.example.com

# ── DB ──
DB_NAME=chungyak
DB_USER=chungyak
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── 공공데이터포털 (필수) ──
PUBLICDATA_SERVICE_KEY=

# ── 관리자 계정 (/api/admin/**) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── LLM (선택 — 없으면 자연어 입력·판정 요약만 비활성) ──
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-sonnet-5
