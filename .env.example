# 배포용 환경변수 템플릿. `cp .env.example .env` 후 값을 채운다.
# .env 는 절대 커밋하지 말 것 (.gitignore 처리됨).

# ── 도메인 (Caddy HTTPS) ──
DOMAIN=chungyak.example.com

# ── DB ──
DB_NAME=chungyak
DB_USER=chungyak
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── 공공데이터포털 (필수) ──
PUBLICDATA_SERVICE_KEY=

# ── 관리자 계정 (/api/admin/**) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 새 공고 알림 메일 (선택 — MAIL_HOST 가 비면 발송을 끄고 화면의 구독 입구도 숨긴다) ──
# APP_BASE_URL 은 확인·해지 링크의 주소. 비우면 https://${DOMAIN}
APP_BASE_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_FROM_ADDRESS=

# ── 개인정보 보호책임자 연락처 (/privacy 에 표시) ──
PRIVACY_CONTACT=

# ── LLM (선택 — 없으면 자연어 입력·판정 요약만 비활성) ──
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-sonnet-5
