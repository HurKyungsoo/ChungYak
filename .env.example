# 배포용 환경변수 템플릿. `cp .env.example .env` 후 값을 채운다.
# .env 는 절대 커밋하지 말 것 (.gitignore 처리됨).

# ── 도메인 (Caddy HTTPS) ──
DOMAIN=chungyak.example.com

# ── DB ──
DB_NAME=chungyak
DB_USER=chungyak
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── 공공데이터포털 (필수) ──
PUBLICDATA_SERVICE_KEY=

# ── 관리자 계정 (/api/admin/**) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 새 공고 알림 메일 (선택 — MAIL_HOST 가 비면 발송을 끄고 화면의 구독 입구도 숨긴다) ──
# APP_BASE_URL 은 확인·해지 링크의 주소. 비우면 https://${DOMAIN}
APP_BASE_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_FROM_ADDRESS=

# ── 개인정보 보호책임자 연락처 (/privacy 에 표시) ──
PRIVACY_CONTACT=

# ── LLM (선택 — 없으면 자연어 입력·판정 요약만 비활성) ──
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-sonnet-5

# ── Groq 무료 등급 (선택 — ANTHROPIC_API_KEY 가 없을 때만 쓴다) ──
# 자연어 입력 추출·공고문 Q&A 답변에 쓴다. 판정 요약은 소득·자산이 들어가 기본으로 보내지 않는다(false).
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXPLAIN_ENABLED=false
# 공고문 Q&A 전용 모델(비우면 GROQ_MODEL) — 하루 토큰 한도(200K)가 모델별이라 추출과 나눠 쓰지 않게
GROQ_QA_MODEL=
# Q&A 의 gpt-oss 추론 토큰 양 low/medium/high (비우면 Groq 기본값 — 추론이 max_tokens 를 다 써 답이 빌 수 있다)
GROQ_QA_REASONING_EFFORT=

# ── Voyage AI 임베딩 (선택 — 공고문 Q&A 의미 검색) ──
# 비우면 BM25(키워드)만. 켜면 이용자 질문이 Voyage(미국)로 가고 /privacy 위탁 항목이 켜진다.
# 69문항 eval(NoticeQaSemanticEvalTest): BM25 43 → 하이브리드 0.4 에서 49. 비용: 한글 글자당 0.72 토큰, 월 ≈ 1,400만(무료 2억 안)
# 키를 처음 넣으면 POST /api/admin/rag/reindex 로 기존 공고를 한 번 임베딩한다(이후에는 수집 때 자동).
VOYAGE_API_KEY=REPLACE_ME
RAG_HYBRID_WEIGHT=0.4
# 재정렬(rerank-2.5, 같은 키) — 하이브리드 상위 N 개를 다시 매긴다. eval 49 → 61(후보 20). 질문당 약 1.4만 토큰
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=20
