# 배포용 환경변수 템플릿. `cp .env.example .env` 후 값을 채운다.
# .env 는 절대 커밋하지 말 것 (.gitignore 처리됨).

# ── 외부 공개 방식 (compose 프로필) ──
#   tunnel       : Cloudflare Tunnel 고정 주소 (TUNNEL_TOKEN 필요)
#   quick-tunnel : Cloudflare 임시 주소 (계정·도메인 불필요)
#   caddy        : 서버 80/443 직접 공개 (DOMAIN 필요)
COMPOSE_PROFILES=tunnel

# ── Cloudflare Tunnel (COMPOSE_PROFILES=tunnel 일 때) ──
TUNNEL_TOKEN=

# ── 도메인 (COMPOSE_PROFILES=caddy 일 때만) ──
DOMAIN=chungyak.example.com

# ── DB ──
DB_NAME=chungyak
DB_USER=chungyak
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── 공공데이터포털 (필수) ──
PUBLICDATA_SERVICE_KEY=

# ── 관리자 계정 (/api/admin/**) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── LLM (선택 — 없으면 자연어 입력·판정 요약만 비활성) ──
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-sonnet-5
